            "order": 8,
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "patternErrorMessage": "Use a hex color like #CD9BFF (or #RRGGBBAA with transparency).",
            "markdownDescription": "`State`, `EndState`, and `Auto` before `State`.\n\nDefault: `#9B37E7` · [Restore default](command:dylbillPapyrus.resetColors?%5B%22stateKeyword%22%5D) · [Open color picker](command:dylbillPapyrus.customizeColors)"
          },
          "dylbillPapyrus.colors.returnKeyword": {
            "type": "string",
            "default": "#C586C0",
