{
  "name": "papyrus-language-by-dylbill",
  "displayName": "Papyrus Language",
  "description": "Fast lightweight language support for papyrus (`.psc`) scripting, written in plain TypeScript with no language server. intellisence, compiling and customizable syntax highlighting.",
  "icon": "Media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dylbill-Iroh/papyrus-language-by-dylbill"
  },
  "version": "0.0.1",
  "author": {
  	"name": "Dylbill",
  	"url": "https://github.com/Dylbill-Iroh"
  },
  "bugs": {
  	"url": "https://github.com/Dylbill-Iroh/papyrus-lang/issues"
  },
    
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:papyrus",
    "workspaceContains:**/*.ppj"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "papyrus",
        "aliases": [
          "Papyrus",
          "papyrus"
        ],
        "extensions": [
          ".psc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "papyrusFunction",
        "superType": "function",
        "description": "Any name followed by (, e.g. MyCustomFunction in MyScript.MyCustomFunction()."
      },
      {
        "id": "papyrusType",
        "superType": "type",
        "description": "Bool, Int, Float, String, Var, Self, Parent, None, and script names: any .psc in a .ppj source folder whose name is longer than 3 characters."
      },
      {
        "id": "papyrusIdentifier",
        "superType": "variable",
        "description": "Every other name: properties, variables and parameters."
      },
      {
        "id": "papyrusFunctionKeyword",
        "superType": "keyword",
        "description": "Function and EndFunction."
      },
      {
        "id": "papyrusEventKeyword",
        "superType": "keyword",
        "description": "Event, EndEvent and CustomEvent."
      },
      {
        "id": "papyrusPropertyKeyword",
        "superType": "keyword",
        "description": "Property, EndProperty and property flags (Auto, AutoReadOnly, Conditional, Hidden, Mandatory)."
      },
      {
        "id": "papyrusStructKeyword",
        "superType": "keyword",
        "description": "Struct and EndStruct (Fallout 4)."
      },
      {
        "id": "papyrusStateKeyword",
        "superType": "keyword",
        "description": "State, EndState, and Auto before State."
      },
      {
        "id": "papyrusReturnKeyword",
        "superType": "keyword",
        "description": "Return."
      },
      {
        "id": "papyrusFlowKeyword",
        "superType": "keyword",
        "description": "If, ElseIf, Else, EndIf, While and EndWhile."
      },
      {
        "id": "papyrusScriptnameKeyword",
        "superType": "keyword",
        "description": "Scriptname."
      },
      {
        "id": "papyrusExtendsKeyword",
        "superType": "keyword",
        "description": "Extends."
      },
      {
        "id": "papyrusKeyword",
        "superType": "keyword",
        "description": "Import, New, As, Is, Native, Global, Const, BetaOnly, DebugOnly, Group/EndGroup, script flags."
      },
      {
        "id": "papyrusConstant",
        "superType": "keyword",
        "description": "True and False."
      },
      {
        "id": "papyrusOperator",
        "superType": "operator",
        "description": "Operators such as = + == != && ||."
      },
      {
        "id": "papyrusString",
        "superType": "string",
        "description": "String literals."
      },
      {
        "id": "papyrusNumber",
        "superType": "number",
        "description": "Number literals."
      },
      {
        "id": "papyrusComment",
        "superType": "comment",
        "description": "; line comments and ;/ block comments /;."
      },
      {
        "id": "papyrusDocComment",
        "superType": "comment",
        "description": "{ documentation comments }."
      }
    ],
    "configuration": [
      {
        "title": "Papyrus (Dylbill)",
        "properties": {
          "dylbillPapyrus.colors.enabled": {
            "type": "boolean",
            "default": true,
            "order": 0,
            "markdownDescription": "Apply the Papyrus colors below. Turn off to use your color theme's colors instead.\n\nColors are applied through `editor.semanticTokenColorCustomizations` in your user settings and only affect Papyrus files.\n\n[Open color picker](command:dylbillPapyrus.customizeColors) · [Restore all colors to defaults](command:dylbillPapyrus.resetColors)"
          },
          "dylbillPapyrus.colors.function": {
            "type": "string",
            "default": "#CD9BFF",
            "format": "color-hex",
            "order": 1,
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "patternErrorMessage": "Use a hex color like #CD9BFF (or #RRGGBBAA with transparency).",
            "markdownDescription": "Any name followed by `(`, e.g. `MyCustomFunction` in `MyScript.MyCustomFunction()`.\n\nDefault: `#CD9BFF` · [Restore default](command:dylbillPapyrus.resetColors?%5B%22function%22%5D) · [Open color picker](command:dylbillPapyrus.customizeColors)"
          },
          "dylbillPapyrus.colors.type": {
            "type": "string",
            "default": "#4EC9B0",
            "format": "color-hex",
            "order": 2,
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "patternErrorMessage": "Use a hex color like #CD9BFF (or #RRGGBBAA with transparency).",
            "markdownDescription": "`Bool`, `Int`, `Float`, `String`, `Var`, `Self`, `Parent`, `None`, and script names: any `.psc` in a `.ppj` source folder whose name is longer than 3 characters.\n\nDefault: `#4EC9B0` · [Restore default](command:dylbillPapyrus.resetColors?%5B%22type%22%5D) · [Open color picker](command:dylbillPapyrus.customizeColors)"
          },
          "dylbillPapyrus.colors.identifier": {
            "type": "string",
