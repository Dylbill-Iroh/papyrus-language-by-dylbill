            "format": "color-hex",
            "order": 11,
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "patternErrorMessage": "Use a hex color like #CD9BFF (or #RRGGBBAA with transparency).",
            "markdownDescription": "`Scriptname`.\n\nDefault: `#386AFF` · [Restore default](command:dylbillPapyrus.resetColors?%5B%22scriptnameKeyword%22%5D) · [Open color picker](command:dylbillPapyrus.customizeColors)"
          },
          "dylbillPapyrus.colors.extendsKeyword": {
            "type": "string",
            "default": "#FFFFFF",
            "format": "color-hex",
            "order": 12,
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "patternErrorMessage": "Use a hex color like #CD9BFF (or #RRGGBBAA with transparency).",
            "markdownDescription": "`Extends`.\n\nDefault: `#FFFFFF` · [Restore default](command:dylbillPapyrus.resetColors?%5B%22extendsKeyword%22%5D) · [Open color picker](command:dylbillPapyrus.customizeColors)"
          },
          "dylbillPapyrus.colors.keyword": {
            "type": "string",
            "default": "#569CD6",
            "format": "color-hex",
            "order": 13,
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "patternErrorMessage": "Use a hex color like #CD9BFF (or #RRGGBBAA with transparency).",
            "markdownDescription": "`Import`, `New`, `As`, `Is`, `Native`, `Global`, `Const`, `BetaOnly`, `DebugOnly`, `Group`/`EndGroup`, script flags.\n\nDefault: `#569CD6` · [Restore default](command:dylbillPapyrus.resetColors?%5B%22keyword%22%5D) · [Open color picker](command:dylbillPapyrus.customizeColors)"
          },
          "dylbillPapyrus.colors.constant": {
            "type": "string",
            "default": "#569CD6",
            "format": "color-hex",
            "order": 14,
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
