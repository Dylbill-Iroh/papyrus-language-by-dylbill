            "patternErrorMessage": "Use a hex color like #CD9BFF (or #RRGGBBAA with transparency).",
            "markdownDescription": "Number literals.\n\nDefault: `#B5CEA8` · [Restore default](command:dylbillPapyrus.resetColors?%5B%22number%22%5D) · [Open color picker](command:dylbillPapyrus.customizeColors)"
          },
          "dylbillPapyrus.colors.comment": {
            "type": "string",
            "default": "#00F445D9",
            "format": "color-hex",
            "order": 18,
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "patternErrorMessage": "Use a hex color like #CD9BFF (or #RRGGBBAA with transparency).",
            "markdownDescription": "`;` line comments and `;/ block comments /;`.\n\nDefault: `#00F445D9` · [Restore default](command:dylbillPapyrus.resetColors?%5B%22comment%22%5D) · [Open color picker](command:dylbillPapyrus.customizeColors)"
          },
          "dylbillPapyrus.colors.docComment": {
            "type": "string",
            "default": "#00F445D9",
            "format": "color-hex",
            "order": 19,
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
