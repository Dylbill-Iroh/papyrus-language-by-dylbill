          }
        }
      },
      {
        "title": "Papyrus (Dylbill) - Compiler",
        "properties": {
          "dylbillPapyrus.compiler.soundFileSuccess": {
            "type": "string",
            "default": "",
            "order": 1,
            "markdownDescription": "Full path to a `.wav` played when a compile succeeds. Without one, a notification is shown instead."
          },
          "dylbillPapyrus.compiler.soundFileFail": {
            "type": "string",
            "default": "",
            "order": 2,
            "markdownDescription": "Full path to a `.wav` played when a compile fails."
          },
          "dylbillPapyrus.compiler.compileOnSave": {
            "type": "boolean",
            "default": false,
            "order": 3,
            "markdownDescription": "Compile a `.psc` script when you save it."
          },
          "dylbillPapyrus.compiler.clearOutputBeforeCompiling": {
            "type": "boolean",
            "default": false,
            "order": 4,
            "markdownDescription": "Clear the **Papyrus Compiler** output panel before each compile."
          }
        }
      }
    ],
    "configurationDefaults": {
      "[papyrus]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "dylbillPapyrus.customizeColors",
        "title": "Customize Colors",
        "category": "Papyrus"
      },
      {
        "command": "dylbillPapyrus.resetColors",
        "title": "Reset All Colors to Defaults",
        "category": "Papyrus"
      },
      {
        "command": "dylbillPapyrus.showProjects",
        "title": "Show Projects and Source Folders",
        "category": "Papyrus"
      },
      {
        "command": "dylbillPapyrus.compileScript",
        "title": "Papyrus - Compile Current Script"
      },
      {
        "command": "dylbillPapyrus.compileAllTabs",
        "title": "Papyrus - Compile All Open Tabs"
      },
      {
        "command": "dylbillPapyrus.compileFolder",
        "title": "Papyrus - Compile All Scripts in Current Folder"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dylbillPapyrus.compileScript",
          "when": "resourceExtname == .psc",
          "group": "papyrus@1"
        },
        {
          "command": "dylbillPapyrus.compileFolder",
          "when": "resourceExtname == .psc",
          "group": "papyrus@2"
        }
      ],
      "explorer/context": [
        {
          "command": "dylbillPapyrus.compileScript",
          "when": "resourceExtname == .psc",
          "group": "papyrus@1"
        },
        {
          "command": "dylbillPapyrus.compileFolder",
          "when": "explorerResourceIsFolder || resourceExtname == .psc",
          "group": "papyrus@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
